#!/bin/bash

#SBATCH --job-name=splat-eval
#SBATCH --partition=gpu
#SBATCH --gpus-per-task=a100:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=00:30:00
#SBATCH --output=/home1/illyhoan/arc/logs/%x-%j.out
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=illyhoan@usc.edu

# Eval-only: re-renders the held-out views from an already-trained run and
# scores them, without retraining. Runs here for the same reason the export
# does: the model only loads onto a CUDA device.
#   sbatch --export=ALL,RUN=interior400,LABEL=run2a eval.job
# LABEL is the run folder under out/<RUN>/splatfacto/. For run 1, which
# predates labels, it is the timestamp: LABEL=2026-09-27_171857.
# Writes out/<RUN>/splatfacto/<LABEL>/eval/metrics.json and
# .../eval/renders/*.png, which scripts/splat_report.py reads as its optional
# fourth argument.

set -euo pipefail

: "${RUN:?export RUN=<dataset-name>}"
: "${LABEL:?export LABEL=<run-label>}"
CARC_OUT="/home1/illyhoan/arc/splatting/out"
RUN_DIR="$CARC_OUT/$RUN/splatfacto/$LABEL"

# Must match setup_env.sh and train.job.
module purge
module load gcc/12.3.0 cuda/12.4.1 python/3.11.9
export LD_LIBRARY_PATH="$(dirname "$(g++ -print-file-name=libstdc++.so.6)"):${LD_LIBRARY_PATH:-}"
# shellcheck disable=SC1091
source "/home1/illyhoan/arc/splatting/.venv/bin/activate"

CONFIG="$RUN_DIR/config.yml"
[ -f "$CONFIG" ] || { echo "no run at $RUN_DIR" >&2; exit 1; }
echo "evaluating $CONFIG"
ns-eval --load-config "$CONFIG" \
  --output-path "$RUN_DIR/eval/metrics.json" \
  --render-output-path "$RUN_DIR/eval/renders"

echo "done; metrics.json and renders under $RUN_DIR/eval"
