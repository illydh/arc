#!/bin/bash

#SBATCH --job-name=augment-combat
#SBATCH --partition=gpu
#SBATCH --gpus-per-task=a100:1
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=48G
#SBATCH --time=01:30:00
#SBATCH --output=/home1/illyhoan/arc/logs/%x-%j.out
#SBATCH --mail-type=END,FAIL
#SBATCH --mail-user=illyhoan@usc.edu

# The combat set: robots in real combat (one robot of a touching pair against
# a robot from another fight, and single robots stopped, flipped or lifted) and
# roster robots with no footage, drawn by the image model. The Mac check
# (augment/out/combat-check) was made the same way with the 4-bit build; this
# colours and draws again with the full model.
# Needs run1's plates and coloured cut-outs on CARC (generate.job made them)
# and carc-combat-inputs.tar.gz unpacked (stage.sh combat). From a CARC
# terminal:
#   sbatch --export=ALL,RUN=combat1 combat.job
# RUN names the output folder, augment/out/<RUN>. N is the number of images,
# NEWBOT_SEEDS the sheets of nine views drawn for each new robot.

set -euo pipefail

: "${RUN:?export RUN=<run-name>}"
N="${N:-3000}"
NEWBOT_SEEDS="${NEWBOT_SEEDS:-1 2 3 4}"
REPO="/home1/illyhoan/arc"

# Must match setup_env.sh.
module purge
module load gcc/12.3.0 cuda/12.4.1 python/3.11.9
# shellcheck disable=SC1091
source "$REPO/augment/.venv/bin/activate"
export HF_HOME="/scratch1/illyhoan/hf"
export HF_HUB_OFFLINE=1
export YOLO_VERBOSE=False
cd "$REPO"

nvidia-smi
python -c "import torch; assert torch.cuda.is_available(), 'no GPU visible'; print('gpu:', torch.cuda.get_device_name(0))"
test -f augment/data/weights/sam2.1_s.pt || { echo "no SAM checkpoint: unpack carc-combat-inputs.tar.gz first" >&2; exit 1; }

# Only plates that passed the checks are used; run1 already set the rest aside.
python augment/scripts/augment_report.py gate
# A picture that already exists is not painted again, so a re-run after a
# failure picks up where it stopped.
python augment/scripts/colorize.py poses fight2 fight3 fight4 fight5 --seeds 7
# shellcheck disable=SC2086
python augment/scripts/colorize.py newbots diablo ginsu malice chopper overkill --seeds $NEWBOT_SEEDS

EACH=$(( (N + 7) / 8 ))
pids=()
for i in 0 1 2 3 4 5 6 7; do
  python augment/scripts/compose.py "$RUN" -n "$EACH" --start $(( i * EACH )) --combat &
  pids+=("$!")
done
for pid in "${pids[@]}"; do wait "$pid"; done

python augment/scripts/augment_report.py "augment/out/$RUN"

# What the model painted and drew goes beside the report, sprites included, so
# that fetching the run is enough to look at it, and to recompose on the Mac
# without a robot that came out wrong.
mkdir -p "augment/out/$RUN/sprites"
cp -R augment/data/sprites/combat augment/data/sprites/newbots "augment/out/$RUN/sprites/"

echo "done; images and report under $REPO/augment/out/$RUN"
